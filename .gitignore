# Virtual environment
venv/
.venv/

# Raw & processed data (too large for git)
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints and artifacts (too large for git)
checkpoints/*.pt
checkpoints/*.pkl
checkpoints/*.npy
checkpoints/*.csv
checkpoints/training_config.json
!checkpoints/.gitkeep
